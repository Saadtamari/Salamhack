    {
      "name": "Storage",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file" },
                { "key": "directory", "type": "text", "value": "uploads" },
                { "key": "bucket", "type": "text", "value": "contracts" },
                { "key": "access", "type": "text", "value": "signed" },
                { "key": "upsert", "type": "text", "value": "false" },
                { "key": "expiresInSeconds", "type": "text", "value": "900" }
              ]
            },
            "url": "{{baseUrl}}/api/storage/upload"
          }
        },
        {
          "name": "Create Signed URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bucket\": \"contracts\",\n  \"path\": \"{{storagePath}}\",\n  \"expiresInSeconds\": 900\n}"
            },
            "url": "{{baseUrl}}/api/storage/signed-url"
          }
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bucket\": \"contracts\",\n  \"path\": \"{{storagePath}}\"\n}"
            },
            "url": "{{baseUrl}}/api/storage/object"
          }
        }
      ]

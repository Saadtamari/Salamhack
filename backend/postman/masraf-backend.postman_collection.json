              "raw": "{\n  \"name\": \"Ahmed Khalid\",\n  \"nameAr\": \"أحمد خالد\",\n  \"email\": \"ahmed@example.com\",\n  \"phone\": \"+962790000000\",\n  \"company\": \"Khalid Studio\",\n  \"companyAr\": \"ستوديو خالد\",\n  \"notes\": \"Top client\",\n  \"riskLevel\": \"low\",\n  \"riskScore\": 4.2,\n  \"totalInvoiced\": 1200,\n  \"totalPaid\": 900,\n  \"totalOverdue\": 300,\n  \"avgPaymentDays\": 18,\n  \"invoicesCount\": 5,\n  \"latePaymentsCount\": 1\n}"
